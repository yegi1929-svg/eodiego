# 로컬 실행용 환경변수 템플릿.
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 .gitignore 대상이다.
#
#   cp .env.example .env
#   bash scripts/run_local.sh

# --- B: 한국관광공사 OpenAPI -------------------------------------------------
# true  = mock 데이터 (키 없이 개발 가능)
# false = 실제 관광공사 API 호출 (KTO_SERVICE_KEY 필요)
USE_MOCK=true

# 공공데이터포털에서 발급받은 서비스키.
# Encoding 키(%2F, %3D 포함)와 Decoding 키 중 어느 쪽을 넣어도 된다
# (B_openapi/config.py 가 한 번 풀어서 쓴다).
KTO_SERVICE_KEY=

# 팀이 확정한 endpoint. 바뀌면 여기서만 고친다.
KTO_BASE_URL=https://apis.data.go.kr/B551011/KorService2
KTO_CONGESTION_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService

# 위치기반 검색 조건. 12=관광지 (비우면 음식점/숙박까지 전부 - 집중률이
# 거의 매칭되지 않는다). numOfRows를 비우면 API 기본값 10건이다.
KTO_CONTENT_TYPE_ID=12
KTO_NUM_OF_ROWS=20
# 상세정보 일괄 조회 상한 (관광지 1곳당 API 2회: 공통정보 + 소개정보).
MAX_DETAIL_BATCH=10

# 실제 API는 mock보다 느리다. 타임아웃/후보 수를 여유 있게 잡는다.
KTO_TIMEOUT_SECONDS=5
KTO_MAX_RETRY=1
MAX_CANDIDATES=20
# 관광공사 API에 동시에 열어둘 연결 수.
KTO_MAX_CONCURRENCY=10

# 일일 호출 한도(계정 등급에 따라 다름). 0이면 한도 추적을 끈다.
# 호출 횟수는 MySQL(kto_api_call)에 남아 재시작해도 유지된다.
KTO_DAILY_QUOTA=1000

# --- C: AI 일정 생성 ---------------------------------------------------------
# false 면 LLM 없이 규칙 기반 + 기본 문구로만 동작한다.
USE_LLM=false
# OpenAI API 키. 채팅/코드에 붙여넣지 말고 이 파일(.env)에만 넣는다.
LLM_API_KEY=
LLM_MODEL=
# 짧은 문장 생성이라 추론 불필요 (추론 토큰은 출력 토큰으로 과금).
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=
# 계정 한도 50 RPD보다 낮게. 도달하면 LLM을 부르지 않고 기본 문구로 전환한다.
LLM_DAILY_REQUEST_LIMIT=
# SDK 자동 재시도도 요청 1회로 세어져 한도를 깎는다.
LLM_MAX_RETRIES=0
# 근거 자료로 넣는 소개문 길이 상한(자).
LLM_OVERVIEW_MAX_CHARS=
# C(및 A)가 B를 호출할 때의 타임아웃.
# 실제 API 기준 B의 집중률 배치는 관광지 1곳당 약 0.4초가 걸린다
# (상세조회가 순차라서 선형으로 늘어난다). 기본 5초로는 20곳에서 터진다.
B_TIMEOUT_SECONDS=

# --- D: BFF ------------------------------------------------------------------
# D가 A/B/C를 호출할 때의 타임아웃. 위와 같은 이유로 기본 6초로는 부족하다.
UPSTREAM_TIMEOUT_SECONDS=

# --- A: 인증/저장 ------------------------------------------------------------
# 쿠키 인증과 함께 쓰므로 와일드카드("*") 금지 - 정확한 origin을 적는다.
ALLOWED_ORIGINS=

# --- MySQL (A/B/C 공통) -------------------------------------------------------
# 앱 계정은 SELECT, INSERT 권한만 있다 (DDL/UPDATE/DELETE 불가).
# 테이블과 계정은 관리자가 db/setup_local.sql (로컬) 또는 db/schema.sql +
# db/create_app_user.sql (운영/RDS) 로 만든다. 코드에는 접속 정보 기본값이 없다.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# RDS에 TLS로 접속할 때 인증서 번들 경로 (선택)
# DB_SSL_CA=

# --- 배포 보안 ---------------------------------------------------------------
# 세션 유지 기간(초). D가 브라우저 쿠키의 max_age로도 쓴다.
SESSION_TTL_SECONDS=
# HTTPS로 서비스하면 반드시 true.
COOKIE_SECURE=
COOKIE_SAMESITE=
# 화면(worker/dev 프록시)만 D를 부를 수 있게 하는 공유 시크릿.
# 비워두면 검사하지 않는다. 배포 시에는 반드시 채운다.
BFF_GATEWAY_TOKEN=

# --- 화면(eodiego) -----------------------------------------------------------
# vite dev 서버와 worker가 /ui/* 를 넘길 D의 주소.
BFF_BASE_URL=
